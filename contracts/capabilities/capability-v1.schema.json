{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-virtual-compute.example/contracts/capabilities/capability-v1.schema.json",
  "title": "Capability Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["purpose", "capabilities", "persistence"],
  "properties": {
    "purpose": {"type": "string", "minLength": 1, "maxLength": 500},
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "browser", "command", "filesystem", "gui", "internet", "python",
          "app.install", "app.control", "screen.read", "input.pointer",
          "input.keyboard", "snapshot", "persistent_storage", "gpu"
        ]
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cpu_millis": {"type": "integer", "minimum": 100},
        "memory_mb": {"type": "integer", "minimum": 128},
        "storage_mb": {"type": "integer", "minimum": 256},
        "gpu_count": {"type": "integer", "minimum": 0}
      }
    },
    "persistence": {"type": "string", "enum": ["ephemeral", "persistent"]},
    "ttl_seconds": {"type": "integer", "minimum": 60, "maximum": 2592000},
    "network_profile": {
      "type": "string",
      "enum": ["normal", "restricted", "offline", "sandbox", "custom_policy"]
    },
    "device_class_hints": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/deviceClass"}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"persistence": {"const": "ephemeral"}}},
      "then": {"required": ["ttl_seconds"]}
    }
  ],
  "$defs": {
    "deviceClass": {
      "type": "string",
      "enum": [
        "BROWSER_WORKSPACE", "CONTAINER_STANDARD", "SECURITY_SANDBOX",
        "LINUX_LIGHT", "LINUX_STANDARD", "DESKTOP_STANDARD", "DESKTOP_POWER",
        "WINDOWS_STANDARD", "WINDOWS_POWER", "ANDROID_STANDARD",
        "ANDROID_LOW_END", "ANDROID_TABLET", "APPLE_SIMULATOR",
        "GPU_WORKSTATION", "DEVELOPMENT_VM"
      ]
    }
  }
}

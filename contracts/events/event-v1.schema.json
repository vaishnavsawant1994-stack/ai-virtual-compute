{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-virtual-compute.example/contracts/events/event-v1.schema.json",
  "title": "Platform Event v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "event_id", "event_type", "tenant_id", "sequence", "occurred_at",
    "request_id", "correlation_id", "actor", "target", "outcome", "integrity"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "event_id": {"type": "string", "pattern": "^evt_[A-Za-z0-9]+$"},
    "tenant_id": {"type": "string", "pattern": "^ten_[A-Za-z0-9]+$"},
    "sequence": {"type": "integer", "minimum": 1},
    "event_type": {
      "type": "string",
      "enum": [
        "resource.requested", "policy.decided", "approval.decided", "device.allocated",
        "device.state_changed", "session.started", "session.ended", "lease.issued",
        "lease.revoked", "control.executed", "credential.issued", "credential.revoked",
        "file.transferred", "snapshot.created", "snapshot.restored", "device.quarantined",
        "device.destroyed", "emergency_stop.activated", "emergency_stop.released",
        "security.detected", "provider.health_changed"
      ]
    },
    "occurred_at": {"type": "string", "format": "date-time"},
    "request_id": {"type": "string", "minLength": 1},
    "correlation_id": {"type": "string", "minLength": 1},
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["principal_id", "client_id"],
      "properties": {
        "principal_id": {"type": "string"},
        "client_id": {"type": "string"},
        "session_id": {"type": ["string", "null"]}
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resource_type", "resource_id"],
      "properties": {
        "resource_type": {"type": "string", "minLength": 1},
        "resource_id": {"type": "string", "minLength": 1}
      }
    },
    "policy_decision_id": {"type": ["string", "null"]},
    "approval_id": {"type": ["string", "null"]},
    "outcome": {"type": "string", "enum": ["allowed", "denied", "succeeded", "failed", "unknown"]},
    "reason_code": {"type": ["string", "null"]},
    "details": {"type": "object"},
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["previous_event_hash", "record_hash"],
      "properties": {
        "previous_event_hash": {"type": ["string", "null"]},
        "record_hash": {"type": "string", "minLength": 16}
      }
    }
  }
}

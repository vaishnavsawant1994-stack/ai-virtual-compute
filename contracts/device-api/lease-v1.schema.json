{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-virtual-compute.example/contracts/device-api/lease-v1.schema.json",
  "title": "Device Lease v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "lease_id", "tenant_id", "principal_id", "client_id", "device_id", "session_id",
    "capabilities", "issued_at", "expires_at", "state", "policy_context_id"
  ],
  "properties": {
    "lease_id": {"type": "string", "pattern": "^lease_[A-Za-z0-9]+$"},
    "tenant_id": {"type": "string", "pattern": "^ten_[A-Za-z0-9]+$"},
    "principal_id": {"type": "string", "pattern": "^prn_[A-Za-z0-9]+$"},
    "client_id": {"type": "string", "pattern": "^cli_[A-Za-z0-9]+$"},
    "device_id": {"type": "string", "pattern": "^dev_[A-Za-z0-9]+$"},
    "session_id": {"type": "string", "pattern": "^ses_[A-Za-z0-9]+$"},
    "capabilities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "state": {"type": "string", "enum": ["issued", "active", "expired", "revoked"]},
    "revoked_at": {"type": ["string", "null"], "format": "date-time"},
    "policy_context_id": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {
      "if": {"properties": {"state": {"const": "revoked"}}},
      "then": {
        "required": ["revoked_at"],
        "properties": {"revoked_at": {"type": "string", "format": "date-time"}}
      }
    }
  ]
}
